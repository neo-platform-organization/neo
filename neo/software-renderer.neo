// Software renderer prototype. Its fields and handlers are copied into an actor.
// Inputs: granted RGBA "buffer" connection; integer coordinates; RGB bytes.
// r-init queries dimensions; r-clear zeroes storage; r-point clips a pixel;
// r-line draws an endpoint-inclusive DDA line in any direction.
// Rendering algorithms live here; native code only accesses buffer memory.
// Fields are scratch state, so these handlers are sequential, not reentrant.
(software-renderer
  (r-width 0)
  (r-height 0)
  (r-x 0)
  (r-y 0)
  (r-x0 0)
  (r-y0 0)
  (r-x1 0)
  (r-y1 0)
  (r-red 64)
  (r-green 200)
  (r-blue 255)
  (r-index 0)
  (r-dx 0)
  (r-dy 0)
  (r-steps 0)
  (r-abs-y 0)
  (r-i 0)
  (r-visible false)
  (handlers
    (r-init
      (body
        (do
          (width (write (slot "r-width") (value (buffer-width (target "buffer")))))
          (height (write (slot "r-height") (value (buffer-height (target "buffer"))))))))
    (r-clear (body (buffer-fill (target "buffer") (value 0))))
    (r-point
      (body
        (do
          (visibility
            (write (slot "r-visible")
              (value
                (and
                  (left
                    (and
                      (left (ge (left (read (slot "r-x"))) (right 0)))
                      (right (lt (left (read (slot "r-x"))) (right (read (slot "r-width")))))))
                  (right
                    (and
                      (left (ge (left (read (slot "r-y"))) (right 0)))
                      (right (lt (left (read (slot "r-y"))) (right (read (slot "r-height")))))))))))
          (plot
            (if (condition (read (slot "r-visible")))
              (then
                (do
                  (address
                    (write (slot "r-index")
                      (value
                        (mul
                          (left
                            (add
                              (left (mul (left (read (slot "r-y"))) (right (read (slot "r-width")))))
                              (right (read (slot "r-x")))))
                          (right 4)))))
                  (red
                    (buffer-write (target "buffer")
                      (index (read (slot "r-index")))
                      (value (read (slot "r-red")))))
                  (green
                    (buffer-write (target "buffer")
                      (index (add (left (read (slot "r-index"))) (right 1)))
                      (value (read (slot "r-green")))))
                  (blue
                    (buffer-write (target "buffer")
                      (index (add (left (read (slot "r-index"))) (right 2)))
                      (value (read (slot "r-blue")))))
                  (alpha
                    (buffer-write (target "buffer")
                      (index (add (left (read (slot "r-index"))) (right 3)))
                      (value 255)))))
              (else))))))
    (r-line
      (body
        (do
          (delta-x
            (write (slot "r-dx") (value (sub (left (read (slot "r-x1"))) (right (read (slot "r-x0")))))))
          (delta-y
            (write (slot "r-dy") (value (sub (left (read (slot "r-y1"))) (right (read (slot "r-y0")))))))
          (abs-x
            (write (slot "r-steps")
              (value
                (if (condition (lt (left (read (slot "r-dx"))) (right 0)))
                  (then (sub (left 0) (right (read (slot "r-dx")))))
                  (else (read (slot "r-dx")))))))
          (abs-y
            (write (slot "r-abs-y")
              (value
                (if (condition (lt (left (read (slot "r-dy"))) (right 0)))
                  (then (sub (left 0) (right (read (slot "r-dy")))))
                  (else (read (slot "r-dy")))))))
          (longest
            (if (condition (gt (left (read (slot "r-abs-y"))) (right (read (slot "r-steps")))))
              (then (write (slot "r-steps") (value (read (slot "r-abs-y")))))
              (else)))
          (reset (write (slot "r-i") (value 0)))
          (draw
            (if (condition (eq (left (read (slot "r-steps"))) (right 0)))
              (then
                (do
                  (x (write (slot "r-x") (value (read (slot "r-x0")))))
                  (y (write (slot "r-y") (value (read (slot "r-y0")))))
                  (point (call (selector "r-point")))))
              (else
                (while (condition (le (left (read (slot "r-i"))) (right (read (slot "r-steps")))))
                  (body
                    (do
                      (x
                        (write (slot "r-x")
                          (value
                            (add
                              (left (read (slot "r-x0")))
                              (right
                                (div
                                  (left (mul (left (read (slot "r-dx"))) (right (read (slot "r-i")))))
                                  (right (read (slot "r-steps")))))))))
                      (y
                        (write (slot "r-y")
                          (value
                            (add
                              (left (read (slot "r-y0")))
                              (right
                                (div
                                  (left (mul (left (read (slot "r-dy"))) (right (read (slot "r-i")))))
                                  (right (read (slot "r-steps")))))))))
                      (point (call (selector "r-point")))
                      (advance (write (slot "r-i") (value (add (left (read (slot "r-i"))) (right 1))))))))))))))))
