                      (slot "row")
                      (value
                        (array-get
                          (slot "segments")
                          (index
                            (read
                              (slot "i")
                            )
                          )
                        )
                      )
                    )
                    (if
                      (<
                        (left
                          (read
                            (slot "row")
                          )
                        )
                        (right 0)
                      )
                      (then
                        (fail)
                      )
                      (else
                        (result 0)
                      )
                    )
                    (if
                      (>=
                        (left
                          (read
                            (slot "row")
                          )
                        )
                        (right
                          (read
                            (slot "count")
                          )
                        )
                      )
                      (then
                        (fail)
                      )
                      (else
                        (result 0)
                      )
                    )
                    (write
                      (slot "i")
                      (value
                        (add
                          (left
                            (read
                              (slot "i")
                            )
                          )
                          (right 1)
                        )
                      )
                    )
                  )
                )
              )
              (write
                (slot "pending")
                (value
                  (array-new
                    (size
                      (mul
                        (left
                          (read
                            (slot "width")
                          )
                        )
                        (right
                          (read
                            (slot "height")
                          )
                        )
                      )
                    )
                    (value 0)
                  )
                )
              )
              (write
                (slot "pending-drawn")
                (value 0)
              )
              (write
                (slot "pending-segments")
                (value 0)
              )
              (write
                (slot "i")
                (value 0)
              )
              (while
                (<
                  (left
                    (read
                      (slot "i")
                    )
                  )
                  (right
                    (array-size
                      (slot "segments")
                    )
                  )
                )
                (body
                  (do
                    (write
                      (slot "a")
                      (value
                        (mul
                          (left
                            (array-get
                              (slot "inverse")
                              (index
                                (array-get
                                  (slot "segments")
                                  (index
                                    (read
                                      (slot "i")
                                    )
                                  )
                                )
                              )
                            )
                          )
                          (right 2)
                        )
                      )
                    )
                    (write
                      (slot "b")
                      (value
                        (mul
                          (left
                            (array-get
                              (slot "inverse")
                              (index
                                (array-get
                                  (slot "segments")
                                  (index
                                    (add
                                      (left
                                        (read
                                          (slot "i")
                                        )
                                      )
                                      (right 1)
                                    )
                                  )
                                )
                              )
                            )
                          )
                          (right 2)
                        )
                      )
                    )
                    (write
                      (slot "x0")
                      (value
                        (array-get
                          (slot "screen")
                          (index
                            (read
                              (slot "a")
                            )
                          )
                        )
                      )
                    )
                    (write
                      (slot "y0")
                      (value
                        (array-get
                          (slot "screen")
                          (index
                            (add
                              (left
                                (read
                                  (slot "a")
                                )
                              )
                              (right 1)
                            )
                          )
                        )
                      )
                    )
                    (write
                      (slot "x1")
                      (value
                        (array-get
                          (slot "screen")
                          (index
                            (read
                              (slot "b")
                            )
                          )
                        )
                      )
                    )
                    (write
                      (slot "y1")
                      (value
                        (array-get
                          (slot "screen")
                          (index
                            (add
                              (left
                                (read
                                  (slot "b")
                                )
                              )
                              (right 1)
                            )
                          )
                        )
                      )
                    )
                    (call
                      (selector "line")
                    )
                    (write
                      (slot "i")
                      (value
                        (add
                          (left
                            (read
                              (slot "i")
                            )
                          )
                          (right 2)
                        )
                      )
                    )
                  )
                )
              )
              (write
                (slot "pixel-mask")
                (value
                  (read
                    (slot "pending")
                  )
                )
              )
              (write
                (slot "drawn-count")
                (value
                  (read
                    (slot "pending-drawn")
                  )
                )
              )
              (write
                (slot "drawn-segments")
                (value
                  (read
                    (slot "pending-segments")
                  )
                )
              )
              (result true)
            )
          )
        )
        (render
          (body
            (do
              (write
                (slot "width")
                (value
                  (buffer-width
                    (target "buffer")
                  )
                )
              )
              (write
                (slot "height")
                (value
                  (buffer-height
                    (target "buffer")
                  )
                )
              )
              (call
                (selector "prepare")
              )
              (buffer-fill
                (target "buffer")
                (value 0)
              )
              (write
                (slot "i")
                (value 0)
              )
              (while
                (<
                  (left
                    (read
                      (slot "i")
                    )
                  )
                  (right
                    (array-size
                      (slot "pixel-mask")
                    )
                  )
                )
                (body
                  (do
                    (if
                      (==
                        (left
                          (array-get
                            (slot "pixel-mask")
                            (index
                              (read
                                (slot "i")
                              )
                            )
                          )
                        )
                        (right 1)
                      )
                      (then
                        (do
                          (buffer-write
                            (target "buffer")
                            (index
                              (add
                                (left
                                  (mul
                                    (left
                                      (read
                                        (slot "i")
                                      )
                                    )
                                    (right 4)
                                  )
                                )
                                (right 0)
                              )
                            )
                            (value
                              (read
                                (slot "red")
                              )
                            )
                          )
                          (buffer-write
                            (target "buffer")
                            (index
                              (add
                                (left
                                  (mul
                                    (left
                                      (read
                                        (slot "i")
                                      )
                                    )
                                    (right 4)
                                  )
                                )
                                (right 1)
                              )
                            )
                            (value
                              (read
                                (slot "green")
                              )
                            )
                          )
                          (buffer-write
                            (target "buffer")
                            (index
                              (add
                                (left
                                  (mul
                                    (left
                                      (read
                                        (slot "i")
                                      )
                                    )
                                    (right 4)
                                  )
                                )
                                (right 2)
                              )
                            )
                            (value
                              (read
                                (slot "blue")
                              )
                            )
                          )
                          (buffer-write
                            (target "buffer")
                            (index
                              (add
                                (left
                                  (mul
                                    (left
                                      (read
                                        (slot "i")
                                      )
                                    )
                                    (right 4)
                                  )
                                )
                                (right 3)
                              )
                            )
                            (value
                              (read
                                (slot "alpha")
                              )
                            )
                          )
                        )
                      )
                      (else
                        (result 0)
                      )
                    )
                    (write
                      (slot "i")
                      (value
                        (add
                          (left
                            (read
                              (slot "i")
                            )
                          )
                          (right 1)
                        )
                      )
                    )
                  )
                )
              )
              (result true)
            )
          )
        )
        (frame
          (body
            (do
              (call
                (selector "render")
              )
              (window-present
                (target "window")
                (buffer "buffer")
              )
            )
          )
        )
      )
    )
  )
)
