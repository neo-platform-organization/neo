      (e-code 0)
      (e-gy 0)
      (e-gx 0)
      (e-bits 0)
      (e-power 0)
      (e-address 0)
      (e-i 0)
      (e-x 0)
      (e-y 0)
      (e-line-start 0)
      (e-line-end 0)
      (e-sline 0)
      (e-eline 0)
      (e-scol 0)
      (e-ecol 0)
      (e-body 40)
      (e-revision -1)
      (e-ready false)
      (e-dirty true)
      (e-painting false)
      (e-readonly false)
      (e-present true)
      (e-selecting false)
      (e-follow true)
      (e-bytes [])
      (e-label "")
      (e-line-text "")
      (e-event "")
      (e-key "")
      (e-insert "")
      (e-copy "")
      (e-status "")
      (glyphs)
      (handlers
        (setup
          (body
            (do
              (write
                (slot "e-width")
