                                                  (write
                                                    (slot "sx")
                                                    (value
                                                      (add
                                                        (left
                                                          (read
                                                            (slot "sx")
                                                          )
                                                        )
                                                        (right 1)
                                                      )
                                                    )
                                                  )
                                                )
                                              )
