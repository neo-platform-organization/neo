                                                              (read
                                                                (slot "y")
                                                              )
                                                            )
                                                            (right
                                                              (mul
                                                                (left
                                                                  (read
                                                                    (slot "row")
                                                                  )
                                                                )
                                                                (right
                                                                  (read
                                                                    (slot "scale")
                                                                  )
                                                                )
