// Minimal scheduled exposure fixture. Endpoint provisioned only by net-grant.
(image
  (scheduler
    (description "Snapshot membership, rotating first entry, bounded dispatch, explicit recovery and work reporting."
)
    (index 0)
    (start 0)
    (cursor 0)
    (count 0)
    (work 0)
    (running false)
    (selected 0)
    (scan-index 0)
    (candidate-name "network")
    (candidate-periodic true)
    (last-error "")
    (last-operation 0)
    (last-receiver 0)
    (entries)
    (entry-prototype (enabled true) (periodic false) (error ""))
    (handlers
      (entry
        (body
          (child-at
            (target (child (target (self)) (name "turn")))
            (index
              (rem
                (left (add (left (read (slot "start"))) (right (read (slot "index")))))
                (right (read (slot "count"))))))))
      (original (body (connection (target (call (selector "entry"))) (name "source-entry"))))
      (target (body (connection (target (call (selector "entry"))) (name "target"))))
      (selected-entry
        (body
          (child-at
            (target (child (target (self)) (name "entries")))
            (index (read (slot "selected"))))))
      (enable
        (body
          (do
            (object-write
              (target (child (target (call (selector "selected-entry"))) (name "enabled")))
              (value true))
            (object-write
              (target (child (target (call (selector "selected-entry"))) (name "error")))
              (value ""))
            (if
              (has-child (target (call (selector "selected-entry"))) (name "error-operation"))
              (then
                (object-write
                  (target
                    (child (target (call (selector "selected-entry"))) (name "error-operation")))
                  (value 0)))
              (else))
            (if
              (has-child (target (call (selector "selected-entry"))) (name "error-receiver"))
              (then
                (object-write
                  (target
                    (child (target (call (selector "selected-entry"))) (name "error-receiver")))
                  (value 0)))
              (else)))))
      (retry
        (body
          (do
            (receiver-retry
              (target (connection (target (call (selector "selected-entry"))) (name "target"))))
            (call (selector "enable")))))
      (discard
        (body
          (do
            (receiver-discard
              (target (connection (target (call (selector "selected-entry"))) (name "target"))))
            (call (selector "enable")))))
      (register
        (body
          (do
            (if (read (slot "candidate-periodic")) (then) (else))
            (write (slot "scan-index") (value 0))
            (while
              (<
                (left (read (slot "scan-index")))
                (right (child-count (target (child (target (self)) (name "entries"))))))
              (body
                (do
                  (if
                    (same
                      (left
                        (connection
                          (target
                            (child-at
                              (target (child (target (self)) (name "entries")))
                              (index (read (slot "scan-index")))))
                          (name "target")))
                      (right (connection (target (self)) (name "candidate"))))
                    (then (fail))
                    (else))
                  (write
                    (slot "scan-index")
                    (value (add (left (read (slot "scan-index"))) (right 1)))))))
            (if
              (has-child
                (target (child (target (self)) (name "entries")))
                (name (read (slot "candidate-name"))))
              (then (fail))
              (else))
            (if
              (has-child (target (self)) (name "pending-entry"))
              (then (object-delete (target (child (target (self)) (name "pending-entry")))))
              (else))
            (object-copy
              (target (child (target (self)) (name "entry-prototype")))
              (destination (self))
              (name "pending-entry"))
            (attempt
              (body
                (do
                  (connect
                    (target (child (target (self)) (name "pending-entry")))
                    (name "target")
                    (value (connection (target (self)) (name "candidate")))
                    (rights 67))
                  (object-write
                    (target
                      (child
                        (target (child (target (self)) (name "pending-entry")))
                        (name "periodic")))
                    (value (read (slot "candidate-periodic"))))
                  (object-move
                    (target (child (target (self)) (name "pending-entry")))
                    (destination (child (target (self)) (name "entries")))
                    (name (read (slot "candidate-name"))))))
              (recover
                (do
                  (if
                    (has-child (target (self)) (name "pending-entry"))
                    (then (object-delete (target (child (target (self)) (name "pending-entry")))))
                    (else))
                  (rethrow)))))))
      (unregister (body (object-delete (target (call (selector "selected-entry"))))))
      (reset
        (body
          (do
            (if
              (has-child (target (self)) (name "turn"))
              (then (object-delete (target (child (target (self)) (name "turn")))))
              (else))
            (if
              (has-child (target (self)) (name "pending-entry"))
              (then (object-delete (target (child (target (self)) (name "pending-entry")))))
              (else))
            (write (slot "running") (value false)))))
      (tick
        (body
          (do
            (if (read (slot "running")) (then (fail)) (else))
            (write (slot "running") (value true))
            (attempt
              (body
                (do
                  (if
                    (has-child (target (self)) (name "turn"))
                    (then (object-delete (target (child (target (self)) (name "turn")))))
                    (else))
                  (object-copy
                    (target (child (target (self)) (name "entries")))
                    (destination (self))
                    (name "turn"))
                  (write
                    (slot "count")
                    (value (child-count (target (child (target (self)) (name "turn"))))))
                  (write (slot "index") (value 0))
                  (write (slot "work") (value 0))
                  (while
                    (< (left (read (slot "index"))) (right (read (slot "count"))))
                    (body
                      (do
                        (attempt
                          (body
                            (disconnect
                              (target
                                (child-at
                                  (target (child (target (self)) (name "turn")))
                                  (index (read (slot "index")))))
                              (name "source-entry")))
                          (recover))
                        (connect
                          (target
                            (child-at
                              (target (child (target (self)) (name "turn")))
                              (index (read (slot "index")))))
                          (name "source-entry")
                          (value
                            (child-at
                              (target (child (target (self)) (name "entries")))
                              (index (read (slot "index")))))
                          (rights 7))
                        (write (slot "index") (value (add (left (read (slot "index"))) (right 1)))))))
                  (write (slot "index") (value 0))
                  (if
                    (< (left 0) (right (read (slot "count"))))
                    (then
                      (do
                        (write
                          (slot "start")
                          (value (rem (left (read (slot "cursor"))) (right (read (slot "count"))))))
                        (write
                          (slot "cursor")
                          (value
                            (rem
                              (left (add (left (read (slot "start"))) (right 1)))
                              (right (read (slot "count"))))))
                        (while
                          (< (left (read (slot "index"))) (right (read (slot "count"))))
                          (body
                            (do
                              (attempt
                                (body
                                  (if
                                    (inspect
                                      (target
                                        (child (target (call (selector "entry"))) (name "enabled"))))
                                    (then
                                      (do
                                        (if
                                          (dispatch (target (call (selector "target"))))
                                          (then
                                            (write
                                              (slot "work")
                                              (value (add (left (read (slot "work"))) (right 1)))))
                                          (else))
                                        (if
                                          (inspect
                                            (target
                                              (child
                                                (target (call (selector "entry")))
                                                (name "periodic"))))
                                          (then
                                            (do
                                              (invoke
                                                (target (call (selector "target")))
                                                (selector "tick"))
                                              (write
                                                (slot "work")
                                                (value (add (left (read (slot "work"))) (right 1))))))
                                          (else))
                                        (attempt
                                          (body
                                            (do
                                              (object-write
                                                (target
                                                  (child
                                                    (target (call (selector "original")))
                                                    (name "error")))
                                                (value ""))
                                              (if
                                                (has-child
                                                  (target (call (selector "original")))
                                                  (name "error-operation"))
                                                (then
                                                  (object-write
                                                    (target
                                                      (child
                                                        (target (call (selector "original")))
                                                        (name "error-operation")))
                                                    (value 0)))
                                                (else))
                                              (if
                                                (has-child
                                                  (target (call (selector "original")))
                                                  (name "error-receiver"))
                                                (then
                                                  (object-write
                                                    (target
                                                      (child
                                                        (target (call (selector "original")))
                                                        (name "error-receiver")))
                                                    (value 0)))
                                                (else))))
                                          (recover))))
                                    (else)))
                                (recover
                                  (do
                                    (write (slot "last-error") (value (failure (field "status"))))
                                    (write
                                      (slot "last-operation")
                                      (value (failure (field "operation"))))
                                    (write
                                      (slot "last-receiver")
                                      (value (failure (field "receiver"))))
                                    (write
                                      (slot "work")
                                      (value (add (left (read (slot "work"))) (right 1))))
                                    (attempt
                                      (body
                                        (do
                                          (if
                                            (has-child
                                              (target (call (selector "original")))
                                              (name "error-operation"))
                                            (then)
                                            (else
                                              (object-create
                                                (target (call (selector "original")))
                                                (name "error-operation")
                                                (value 0))))
                                          (if
                                            (has-child
                                              (target (call (selector "original")))
                                              (name "error-receiver"))
                                            (then)
                                            (else
                                              (object-create
                                                (target (call (selector "original")))
                                                (name "error-receiver")
                                                (value 0))))
                                          (object-write
                                            (target
                                              (child
                                                (target (call (selector "original")))
                                                (name "error")))
                                            (value (read (slot "last-error"))))
                                          (object-write
                                            (target
                                              (child
                                                (target (call (selector "original")))
                                                (name "error-operation")))
                                            (value (read (slot "last-operation"))))
                                          (object-write
                                            (target
                                              (child
                                                (target (call (selector "original")))
                                                (name "error-receiver")))
                                            (value (read (slot "last-receiver"))))
                                          (object-write
                                            (target
                                              (child
                                                (target (call (selector "original")))
                                                (name "enabled")))
                                            (value false))))
                                      (recover)))))
                              (write
                                (slot "index")
                                (value (add (left (read (slot "index"))) (right 1)))))))))
                    (else))
                  (if
                    (has-child (target (self)) (name "turn"))
                    (then (object-delete (target (child (target (self)) (name "turn")))))
                    (else))
                  (write (slot "running") (value false))
                  (read (slot "work"))))
              (recover
                (do
                  (if
                    (has-child (target (self)) (name "turn"))
                    (then (object-delete (target (child (target (self)) (name "turn")))))
                    (else))
                  (write (slot "running") (value false))
                  (rethrow)))))))))
  (service #service
    (heartbeats false)
    (activity 0)
    (last-probe 0)
    (alive-pending false)
    (acknowledgements false)
    (ack-pending false)
    (receipt-pending false)
    (decision-pending false)
    (candidate-reply-active false)
    (candidate-revision 0)
    (reply-event "")
    (decision "")
    (origin "local")
    (publication "example")
    (revision 0)
    (accept-name "accepted")
    (valid false)
    (complete false)
    (inbox)
    (accepted)
    (handlers
      (revision-policy
        (body
          (if
            (<=
              (left
                (inspect
                  (target
                    (child
                      (target (connection (target (self)) (name "candidate")))
                      (name "revision")))))
              (right (read (slot "revision"))))
            (then (fail))
            (else))))
      (validate
        (body
          (do
            (write (slot "valid") (value false))
            (if (== (left (read (slot "origin"))) (right "")) (then (fail)) (else))
            (if (== (left (read (slot "publication"))) (right "")) (then (fail)) (else))
            (if
              (!=
                (left
                  (inspect
                    (target
                      (child
                        (target (connection (target (self)) (name "candidate")))
                        (name "schema")))))
                (right 1))
              (then (fail))
              (else))
            (if
              (!=
                (left
                  (inspect
                    (target
                      (child
                        (target (connection (target (self)) (name "candidate")))
                        (name "origin")))))
                (right (read (slot "origin"))))
              (then (fail))
              (else))
            (if
              (!=
                (left
                  (inspect
                    (target
                      (child
                        (target (connection (target (self)) (name "candidate")))
                        (name "publication")))))
                (right (read (slot "publication"))))
              (then (fail))
              (else))
            (if
              (<=
                (left
                  (inspect
                    (target
                      (child
                        (target (connection (target (self)) (name "candidate")))
                        (name "revision")))))
                (right 0))
              (then (fail))
              (else))
            (if
              (==
                (left
                  (inspect
                    (target
                      (child
                        (target (connection (target (self)) (name "candidate")))
                        (name "event")))))
                (right "snapshot"))
              (then
                (do
                  (if
                    (not
                      (value
                        (has-child
                          (target (connection (target (self)) (name "candidate")))
                          (name "state"))))
                    (then (fail))
                    (else))
                  (if
                    (!=
                      (left (child-count (target (connection (target (self)) (name "candidate")))))
                      (right 6))
                    (then (fail))
                    (else))))
              (else
                (do
                  (if
                    (!=
                      (left
                        (inspect
                          (target
                            (child
                              (target (connection (target (self)) (name "candidate")))
                              (name "event")))))
                      (right "withdrawal"))
                    (then (fail))
                    (else))
                  (if
                    (!=
                      (left (child-count (target (connection (target (self)) (name "candidate")))))
                      (right 5))
                    (then (fail))
                    (else)))))
            (call (selector "revision-policy"))
            (write (slot "valid") (value true))
            (result true))))
      (receive
        (body
          (do
            (if
              (read (slot "acknowledgements"))
              (then
                (if
                  (or
                    (left (read (slot "ack-pending")))
                    (right
                      (or
                        (left (read (slot "receipt-pending")))
                        (right (read (slot "decision-pending"))))))
                  (then (fail))
                  (else)))
              (else (result 0)))
            (do
              (if
                (has-child (target (child (target (self)) (name "inbox"))) (name "candidate"))
                (then (fail))
                (else))
              (write
                (slot "complete")
                (value (replica-receive (target (connection (target (self)) (name "channel"))))))
              (if
                (read (slot "complete"))
                (then
                  (do
                    (replica-import
                      (target (connection (target (self)) (name "channel")))
                      (destination (child (target (self)) (name "inbox")))
                      (name "candidate"))
                    (connect
                      (target (self))
                      (name "candidate")
                      (value
                        (child (target (child (target (self)) (name "inbox"))) (name "candidate")))
                      (rights 9))
                    (call (selector "validate"))))
                (else false)))
            (if
              (read (slot "acknowledgements"))
              (then
                (if
                  (read (slot "complete"))
                  (then
                    (do
                      (write
                        (slot "candidate-revision")
                        (value
                          (inspect
                            (target
                              (child
                                (target (connection (target (self)) (name "candidate")))
                                (name "revision"))))))
                      (write (slot "candidate-reply-active") (value true))
                      (write (slot "receipt-pending") (value true))))
                  (else (result 0))))
              (else (result 0)))
            (read (slot "complete")))))
      (accept
        (body
          (do
            (do
              (call (selector "validate"))
              (object-copy
                (target (connection (target (self)) (name "candidate")))
                (destination (child (target (self)) (name "accepted")))
                (name (read (slot "accept-name"))))
              (write
                (slot "revision")
                (value
                  (inspect
                    (target
                      (child
                        (target (connection (target (self)) (name "candidate")))
                        (name "revision"))))))
              (disconnect (target (self)) (name "candidate"))
              (object-delete
                (target (child (target (child (target (self)) (name "inbox"))) (name "candidate"))))
              (write (slot "valid") (value false))
              (read (slot "revision")))
            (if
              (read (slot "acknowledgements"))
              (then
                (if
                  (read (slot "candidate-reply-active"))
                  (then
                    (do
                      (write (slot "decision") (value "accepted"))
                      (write (slot "decision-pending") (value true))
                      (write (slot "candidate-reply-active") (value false))))
                  (else (result 0))))
              (else (result 0)))
            (read (slot "revision")))))
      (reject
        (body
          (do
            (do
              (disconnect (target (self)) (name "candidate"))
              (object-delete
                (target (child (target (child (target (self)) (name "inbox"))) (name "candidate"))))
              (write (slot "valid") (value false))
              (result true))
            (if
              (read (slot "acknowledgements"))
              (then
                (if
                  (read (slot "candidate-reply-active"))
                  (then
                    (do
                      (write (slot "decision") (value "rejected"))
                      (write (slot "decision-pending") (value true))
                      (write (slot "candidate-reply-active") (value false))))
                  (else (result 0))))
              (else (result 0)))
            (result true))))
      (reply-busy
        (body
          (or
            (left
              (or
                (left (read (slot "ack-pending")))
                (right
                  (or
                    (left (read (slot "receipt-pending")))
                    (right (read (slot "decision-pending")))))))
            (right (read (slot "alive-pending"))))))
      (prepare-reply
        (body
          (do
            (if
              (has-child (target (self)) (name "reply-draft"))
              (then (object-delete (target (child (target (self)) (name "reply-draft")))))
              (else))
            (object-create (target (self)) (name "reply-draft") (value (unit)))
            (object-create
              (target (child (target (self)) (name "reply-draft")))
              (name "schema")
              (value 1))
            (object-create
              (target (child (target (self)) (name "reply-draft")))
              (name "origin")
              (value (read (slot "origin"))))
            (object-create
              (target (child (target (self)) (name "reply-draft")))
              (name "publication")
              (value (read (slot "publication"))))
            (object-create
              (target (child (target (self)) (name "reply-draft")))
              (name "revision")
              (value (read (slot "candidate-revision"))))
            (object-create
              (target (child (target (self)) (name "reply-draft")))
              (name "event")
              (value (read (slot "reply-event"))))
            (replica-prepare
              (target (connection (target (self)) (name "channel")))
              (value (child (target (self)) (name "reply-draft"))))
            (write (slot "ack-pending") (value true)))))
      (send-reply
        (body
          (do
            (if (not (value (read (slot "acknowledgements")))) (then (fail)) (else))
            (if
              (or
                (left (read (slot "ack-pending")))
                (right
                  (or
                    (left (read (slot "receipt-pending")))
                    (right (read (slot "decision-pending"))))))
              (then
                (do
                  (if (not (value (read (slot "acknowledgements")))) (then (fail)) (else))
                  (if
                    (read (slot "ack-pending"))
                    (then
                      (if
                        (replica-send (target (connection (target (self)) (name "channel"))))
                        (then (write (slot "ack-pending") (value false)))
                        (else (result 0))))
                    (else
                      (if
                        (read (slot "receipt-pending"))
                        (then
                          (do
                            (write (slot "reply-event") (value "received"))
                            (call (selector "prepare-reply"))
                            (write (slot "receipt-pending") (value false))))
                        (else
                          (if
                            (read (slot "decision-pending"))
                            (then
                              (do
                                (write (slot "reply-event") (value (read (slot "decision"))))
                                (call (selector "prepare-reply"))
                                (write (slot "decision-pending") (value false))))
                            (else (result 0)))))))
                  (result 0)))
              (else
                (if
                  (read (slot "alive-pending"))
                  (then (call (selector "prepare-alive")))
                  (else (result 0)))))
            (result 0))))
      (reset-replies
        (body
          (do
            (write (slot "ack-pending") (value false))
            (write (slot "receipt-pending") (value false))
            (write (slot "decision-pending") (value false))
            (write (slot "candidate-reply-active") (value false))
            (write (slot "alive-pending") (value false))
            (write (slot "last-probe") (value 0))
            (if
              (has-child (target (self)) (name "incoming"))
              (then (object-delete (target (child (target (self)) (name "incoming")))))
              (else))
            (if
              (has-child (target (self)) (name "deferred"))
              (then (object-delete (target (child (target (self)) (name "deferred")))))
              (else))
            (if
              (has-child (target (self)) (name "reply-draft"))
              (then (object-delete (target (child (target (self)) (name "reply-draft")))))
              (else))
            (result true))))
      (defer-candidate
        (body
          (do
            (if (has-child (target (self)) (name "deferred")) (then (fail)) (else))
            (object-copy
              (target (child (target (self)) (name "incoming")))
              (destination (self))
              (name "deferred"))
            (result true))))
      (promote-deferred
        (body
          (do
            (object-copy
              (target (child (target (self)) (name "deferred")))
              (destination (self))
              (name "incoming"))
            (object-delete (target (child (target (self)) (name "deferred"))))
            (call (selector "handle-incoming")))))
      (validate-probe
        (body
          (do
            (if (not (value (read (slot "heartbeats")))) (then (fail)) (else))
            (if (not (value (read (slot "acknowledgements")))) (then (fail)) (else))
            (if
              (!= (left (child-count (target (child (target (self)) (name "incoming"))))) (right 5))
              (then (fail))
              (else))
            (if
              (!=
                (left
                  (inspect
                    (target
                      (child (target (child (target (self)) (name "incoming"))) (name "schema")))))
                (right 1))
              (then (fail))
              (else))
            (if
              (!=
                (left
                  (inspect
                    (target
                      (child (target (child (target (self)) (name "incoming"))) (name "origin")))))
                (right (read (slot "origin"))))
              (then (fail))
              (else))
            (if
              (!=
                (left
                  (inspect
                    (target
                      (child
                        (target (child (target (self)) (name "incoming")))
                        (name "publication")))))
                (right (read (slot "publication"))))
              (then (fail))
              (else))
            (if
              (<=
                (left
                  (inspect
                    (target
                      (child (target (child (target (self)) (name "incoming"))) (name "sequence")))))
                (right (read (slot "last-probe"))))
              (then (fail))
              (else))
            (write
              (slot "last-probe")
              (value
                (inspect
                  (target
                    (child (target (child (target (self)) (name "incoming"))) (name "sequence"))))))
            (write (slot "alive-pending") (value true))
            (result true))))
      (handle-incoming
        (body
          (do
            (if
              (==
                (left
                  (inspect
                    (target
                      (child (target (child (target (self)) (name "incoming"))) (name "event")))))
                (right "probe"))
              (then
                (do
                  (call (selector "validate-probe"))
                  (write (slot "activity") (value (add (left (read (slot "activity"))) (right 1))))
                  (result true)))
              (else
                (if
                  (has-child (target (child (target (self)) (name "inbox"))) (name "candidate"))
                  (then (call (selector "defer-candidate")))
                  (else
                    (do
                      (do
                        (if
                          (has-child
                            (target (child (target (self)) (name "inbox")))
