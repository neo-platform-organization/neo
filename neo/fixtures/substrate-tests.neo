// Test fixture only: examples deliberately excluded from the OS boot image.
(image #world
  (packages #packages
    (system
      (counter
        (description "A live counter. tick adds increment to value; reset clears value.")
        (value 0)
        (increment 1)
        (handlers
          (tick
            (body
              (write
                (slot "value")
                (value (add (left (read (slot "value"))) (right (read (slot "increment"))))))))
          (reset (body (write (slot "value") (value 0)))))))
    (maths
      (vector #vector
        (left-values [1 2 3])
        (right-values [4 5 6])
        (index 0)
        (sum 0)
        (handlers
          (dot
            (body
              (do
                (if
                  (!=
                    (left (array-size (slot "left-values")))
                    (right (array-size (slot "right-values"))))
                  (then (fail))
                  (else))
                (write (slot "index") (value 0))
                (write (slot "sum") (value 0))
                (while
                  (< (left (read (slot "index"))) (right (array-size (slot "left-values"))))
                  (body
                    (do
                      (write
                        (slot "sum")
                        (value
                          (add
                            (left (read (slot "sum")))
                            (right
                              (mul
                                (left (array-get (slot "left-values") (index (read (slot "index")))))
                                (right (array-get (slot "right-values") (index (read (slot "index"))))))))))
                      (write (slot "index") (value (add (left (read (slot "index"))) (right 1)))))))
                (return (value (read (slot "sum"))))))))))
    (spatial
      (point #point
        (dimensions 3)
        (coordinates [0 0 0])
        (handlers
          (valid
            (body
              (return
                (value
                  (and
                    (left (>= (left (read (slot "dimensions"))) (right 0)))
                    (right
                      (== (left (read (slot "dimensions"))) (right (array-size (slot "coordinates"))))))))))))))
  (workspace #workspace)
  (browser @packages #packages 1 @workspace #workspace 255 @vector #vector 9 @point #point 9
    (package-index 0)
    (prototype-index 0)
    (output "")
    (offset 0)
    (written 0)
    (finished false)
    (handlers
      (main
        (body
          (do
            (write (slot "output") (value "Project Substrate - live prototype browser"))
            (call (selector "emit"))
            (write (slot "output") (value "\n"))
            (call (selector "emit"))
            (write (slot "package-index") (value 0))
            (while
              (<
                (left (read (slot "package-index")))
                (right (child-count (target (connection (target (self)) (name "packages"))))))
              (body
                (do
                  (write (slot "output") (value "package "))
                  (call (selector "emit"))
                  (write
                    (slot "output")
                    (value
                      (object-name
                        (target
                          (child-at
                            (target (connection (target (self)) (name "packages")))
                            (index (read (slot "package-index"))))))))
                  (call (selector "emit"))
                  (write (slot "output") (value "\n"))
                  (call (selector "emit"))
                  (write (slot "prototype-index") (value 0))
                  (while
                    (<
                      (left (read (slot "prototype-index")))
                      (right
                        (child-count
                          (target
                            (child-at
                              (target (connection (target (self)) (name "packages")))
                              (index (read (slot "package-index"))))))))
                    (body
                      (do
                        (write (slot "output") (value "  prototype "))
                        (call (selector "emit"))
                        (write
                          (slot "output")
                          (value
                            (object-name
                              (target
                                (child-at
                                  (target
                                    (child-at
                                      (target (connection (target (self)) (name "packages")))
                                      (index (read (slot "package-index")))))
                                  (index (read (slot "prototype-index"))))))))
                        (call (selector "emit"))
                        (write (slot "output") (value " | children: "))
                        (call (selector "emit"))
                        (write
                          (slot "output")
                          (value
                            (to-text
                              (value
                                (child-count
                                  (target
                                    (child-at
                                      (target
                                        (child-at
                                          (target (connection (target (self)) (name "packages")))
                                          (index (read (slot "package-index")))))
                                      (index (read (slot "prototype-index"))))))))))
                        (call (selector "emit"))
                        (write (slot "output") (value "\n"))
                        (call (selector "emit"))
                        (write
                          (slot "prototype-index")
                          (value (add (left (read (slot "prototype-index"))) (right 1)))))))
                  (write
                    (slot "package-index")
                    (value (add (left (read (slot "package-index"))) (right 1)))))))
            (write (slot "output") (value "Workspace objects: "))
            (call (selector "emit"))
            (write
              (slot "output")
              (value
                (to-text (value (child-count (target (connection (target (self)) (name "workspace"))))))))
            (call (selector "emit"))
            (write (slot "output") (value "\n"))
            (call (selector "emit")))))
      (demo
        (body
          (do
            (call (selector "main"))
            (if
              (has-child (target (connection (target (self)) (name "workspace"))) (name "vector-copy"))
              (then
                (object-delete
                  (target
                    (child (target (connection (target (self)) (name "workspace"))) (name "vector-copy")))))
              (else))
            (object-copy
              (target (connection (target (self)) (name "vector")))
              (destination (connection (target (self)) (name "workspace")))
              (name "vector-copy"))
            (if
              (has-child (target (connection (target (self)) (name "workspace"))) (name "point-copy"))
              (then
                (object-delete
                  (target
                    (child (target (connection (target (self)) (name "workspace"))) (name "point-copy")))))
              (else))
            (object-copy
              (target (connection (target (self)) (name "point")))
              (destination (connection (target (self)) (name "workspace")))
              (name "point-copy"))
            (object-write
              (target
                (child
                  (target
                    (child (target (connection (target (self)) (name "workspace"))) (name "vector-copy")))
                  (name "left-values")))
              (value [1 2 3 4]))
            (object-write
              (target
                (child
                  (target
                    (child (target (connection (target (self)) (name "workspace"))) (name "vector-copy")))
                  (name "right-values")))
              (value [5 6 7 8]))
            (write (slot "output") (value "4D dot product: "))
            (call (selector "emit"))
            (write
              (slot "output")
              (value
                (to-text
                  (value
                    (invoke
                      (target
                        (child
                          (target (connection (target (self)) (name "workspace")))
                          (name "vector-copy")))
                      (selector "dot"))))))
            (call (selector "emit"))
            (write (slot "output") (value "\n"))
            (call (selector "emit"))
            (object-write
              (target
                (child
                  (target
                    (child (target (connection (target (self)) (name "workspace"))) (name "point-copy")))
                  (name "dimensions")))
              (value 4))
            (object-write
              (target
                (child
                  (target
                    (child (target (connection (target (self)) (name "workspace"))) (name "point-copy")))
                  (name "coordinates")))
              (value [10 20 30 40]))
            (write (slot "output") (value "4D point shape valid: "))
            (call (selector "emit"))
            (write
              (slot "output")
              (value
                (to-text
                  (value
                    (invoke
                      (target
                        (child
                          (target (connection (target (self)) (name "workspace")))
                          (name "point-copy")))
                      (selector "valid"))))))
            (call (selector "emit"))
            (write (slot "output") (value "\n"))
            (call (selector "emit"))
            (write (slot "output") (value "Original point dimension: "))
            (call (selector "emit"))
            (write
              (slot "output")
              (value
                (to-text
                  (value
                    (inspect
                      (target
                        (child (target (connection (target (self)) (name "point"))) (name "dimensions"))))))))
            (call (selector "emit"))
            (write (slot "output") (value "\n"))
            (call (selector "emit"))
            (write (slot "output") (value "Independent workspace copies: "))
            (call (selector "emit"))
            (write
              (slot "output")
              (value
                (to-text (value (child-count (target (connection (target (self)) (name "workspace"))))))))
            (call (selector "emit"))
            (write (slot "output") (value "\n"))
            (call (selector "emit")))))
      (emit
        (body
          (do
            (write (slot "offset") (value 0))
            (write (slot "finished") (value false))
            (while
              (not (value (read (slot "finished"))))
              (body
                (do
                  (write
                    (slot "written")
                    (value
                      (stream-write
                        (target "stdout")
                        (value (read (slot "output")))
                        (offset (read (slot "offset"))))))
                  (if
                    (== (left (read (slot "written"))) (right "would-block"))
                    (then (fail))
                    (else
                      (if
                        (== (left (read (slot "written"))) (right 0))
                        (then (write (slot "finished") (value true)))
                        (else
                          (write
                            (slot "offset")
                            (value (add (left (read (slot "offset"))) (right (read (slot "written")))))))))))))))))))
