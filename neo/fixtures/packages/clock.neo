// Dependency for package-contract-v1.neo; an explicitly shared read-only clock service.
(package
  (manifest
    (schema 1)
    (id "local.clock")
    (version (major 1) (minor 0) (patch 0))
    (dependencies)
    (exports
      (clock (path "contents/clock") (mode "service") (rights 65)))
    (imports)
    (bindings))
  (contents
    (clock
      (ticks 0)
      (handlers
        (now (body (read (slot "ticks"))))))))
