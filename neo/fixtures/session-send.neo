// Minimal scheduled exposure fixture. Endpoint provisioned only by net-grant.
(image
  (scheduler
    (description "Snapshot membership, rotating first entry, bounded dispatch, explicit recovery and work reporting."
)
    (index 0)
    (start 0)
    (cursor 0)
    (count 0)
    (work 0)
    (running false)
    (selected 0)
    (scan-index 0)
    (candidate-name "network")
    (candidate-periodic true)
    (last-error "")
    (last-operation 0)
    (last-receiver 0)
    (entries)
    (entry-prototype (enabled true) (periodic false) (error ""))
    (handlers
      (entry
        (body
          (child-at
            (target (child (target (self)) (name "turn")))
            (index
              (rem
                (left (add (left (read (slot "start"))) (right (read (slot "index")))))
                (right (read (slot "count"))))))))
      (original (body (connection (target (call (selector "entry"))) (name "source-entry"))))
      (target (body (connection (target (call (selector "entry"))) (name "target"))))
      (selected-entry
        (body
          (child-at
            (target (child (target (self)) (name "entries")))
            (index (read (slot "selected"))))))
      (enable
        (body
          (do
            (object-write
              (target (child (target (call (selector "selected-entry"))) (name "enabled")))
              (value true))
            (object-write
              (target (child (target (call (selector "selected-entry"))) (name "error")))
              (value ""))
            (if
              (has-child (target (call (selector "selected-entry"))) (name "error-operation"))
              (then
                (object-write
                  (target
                    (child (target (call (selector "selected-entry"))) (name "error-operation")))
                  (value 0)))
              (else))
            (if
              (has-child (target (call (selector "selected-entry"))) (name "error-receiver"))
              (then
                (object-write
                  (target
                    (child (target (call (selector "selected-entry"))) (name "error-receiver")))
                  (value 0)))
              (else)))))
      (retry
        (body
          (do
            (receiver-retry
              (target (connection (target (call (selector "selected-entry"))) (name "target"))))
            (call (selector "enable")))))
      (discard
        (body
          (do
            (receiver-discard
              (target (connection (target (call (selector "selected-entry"))) (name "target"))))
            (call (selector "enable")))))
      (register
        (body
          (do
            (if (read (slot "candidate-periodic")) (then) (else))
            (write (slot "scan-index") (value 0))
            (while
              (<
                (left (read (slot "scan-index")))
                (right (child-count (target (child (target (self)) (name "entries"))))))
              (body
                (do
                  (if
                    (same
                      (left
                        (connection
                          (target
                            (child-at
                              (target (child (target (self)) (name "entries")))
                              (index (read (slot "scan-index")))))
                          (name "target")))
                      (right (connection (target (self)) (name "candidate"))))
                    (then (fail))
                    (else))
                  (write
                    (slot "scan-index")
                    (value (add (left (read (slot "scan-index"))) (right 1)))))))
            (if
              (has-child
                (target (child (target (self)) (name "entries")))
                (name (read (slot "candidate-name"))))
              (then (fail))
              (else))
            (if
              (has-child (target (self)) (name "pending-entry"))
              (then (object-delete (target (child (target (self)) (name "pending-entry")))))
              (else))
            (object-copy
              (target (child (target (self)) (name "entry-prototype")))
              (destination (self))
              (name "pending-entry"))
            (attempt
              (body
                (do
                  (connect
                    (target (child (target (self)) (name "pending-entry")))
                    (name "target")
                    (value (connection (target (self)) (name "candidate")))
                    (rights 67))
                  (object-write
                    (target
                      (child
                        (target (child (target (self)) (name "pending-entry")))
                        (name "periodic")))
                    (value (read (slot "candidate-periodic"))))
                  (object-move
                    (target (child (target (self)) (name "pending-entry")))
                    (destination (child (target (self)) (name "entries")))
                    (name (read (slot "candidate-name"))))))
              (recover
                (do
                  (if
                    (has-child (target (self)) (name "pending-entry"))
                    (then (object-delete (target (child (target (self)) (name "pending-entry")))))
                    (else))
                  (rethrow)))))))
      (unregister (body (object-delete (target (call (selector "selected-entry"))))))
      (reset
        (body
          (do
            (if
              (has-child (target (self)) (name "turn"))
              (then (object-delete (target (child (target (self)) (name "turn")))))
              (else))
            (if
              (has-child (target (self)) (name "pending-entry"))
              (then (object-delete (target (child (target (self)) (name "pending-entry")))))
              (else))
            (write (slot "running") (value false)))))
      (tick
        (body
          (do
            (if (read (slot "running")) (then (fail)) (else))
            (write (slot "running") (value true))
            (attempt
              (body
                (do
                  (if
                    (has-child (target (self)) (name "turn"))
                    (then (object-delete (target (child (target (self)) (name "turn")))))
                    (else))
                  (object-copy
                    (target (child (target (self)) (name "entries")))
                    (destination (self))
                    (name "turn"))
                  (write
                    (slot "count")
                    (value (child-count (target (child (target (self)) (name "turn"))))))
                  (write (slot "index") (value 0))
                  (write (slot "work") (value 0))
                  (while
                    (< (left (read (slot "index"))) (right (read (slot "count"))))
                    (body
                      (do
                        (attempt
                          (body
                            (disconnect
                              (target
                                (child-at
                                  (target (child (target (self)) (name "turn")))
                                  (index (read (slot "index")))))
                              (name "source-entry")))
                          (recover))
                        (connect
                          (target
                            (child-at
                              (target (child (target (self)) (name "turn")))
                              (index (read (slot "index")))))
                          (name "source-entry")
                          (value
                            (child-at
                              (target (child (target (self)) (name "entries")))
                              (index (read (slot "index")))))
                          (rights 7))
                        (write (slot "index") (value (add (left (read (slot "index"))) (right 1)))))))
                  (write (slot "index") (value 0))
                  (if
                    (< (left 0) (right (read (slot "count"))))
                    (then
                      (do
                        (write
                          (slot "start")
                          (value (rem (left (read (slot "cursor"))) (right (read (slot "count"))))))
                        (write
                          (slot "cursor")
                          (value
                            (rem
                              (left (add (left (read (slot "start"))) (right 1)))
                              (right (read (slot "count"))))))
                        (while
                          (< (left (read (slot "index"))) (right (read (slot "count"))))
                          (body
                            (do
                              (attempt
                                (body
                                  (if
                                    (inspect
                                      (target
                                        (child (target (call (selector "entry"))) (name "enabled"))))
                                    (then
                                      (do
                                        (if
                                          (dispatch (target (call (selector "target"))))
                                          (then
                                            (write
                                              (slot "work")
                                              (value (add (left (read (slot "work"))) (right 1)))))
                                          (else))
                                        (if
                                          (inspect
                                            (target
                                              (child
                                                (target (call (selector "entry")))
                                                (name "periodic"))))
                                          (then
                                            (do
                                              (invoke
                                                (target (call (selector "target")))
                                                (selector "tick"))
                                              (write
                                                (slot "work")
                                                (value (add (left (read (slot "work"))) (right 1))))))
                                          (else))
                                        (attempt
                                          (body
                                            (do
                                              (object-write
                                                (target
                                                  (child
                                                    (target (call (selector "original")))
                                                    (name "error")))
                                                (value ""))
                                              (if
                                                (has-child
                                                  (target (call (selector "original")))
                                                  (name "error-operation"))
                                                (then
                                                  (object-write
                                                    (target
                                                      (child
                                                        (target (call (selector "original")))
                                                        (name "error-operation")))
                                                    (value 0)))
                                                (else))
                                              (if
                                                (has-child
                                                  (target (call (selector "original")))
                                                  (name "error-receiver"))
                                                (then
                                                  (object-write
                                                    (target
                                                      (child
                                                        (target (call (selector "original")))
                                                        (name "error-receiver")))
                                                    (value 0)))
                                                (else))))
                                          (recover))))
                                    (else)))
                                (recover
                                  (do
                                    (write (slot "last-error") (value (failure (field "status"))))
                                    (write
                                      (slot "last-operation")
                                      (value (failure (field "operation"))))
                                    (write
                                      (slot "last-receiver")
                                      (value (failure (field "receiver"))))
                                    (write
                                      (slot "work")
                                      (value (add (left (read (slot "work"))) (right 1))))
                                    (attempt
                                      (body
                                        (do
                                          (if
                                            (has-child
                                              (target (call (selector "original")))
                                              (name "error-operation"))
                                            (then)
                                            (else
                                              (object-create
                                                (target (call (selector "original")))
                                                (name "error-operation")
                                                (value 0))))
                                          (if
                                            (has-child
                                              (target (call (selector "original")))
                                              (name "error-receiver"))
                                            (then)
                                            (else
                                              (object-create
                                                (target (call (selector "original")))
                                                (name "error-receiver")
                                                (value 0))))
                                          (object-write
                                            (target
                                              (child
                                                (target (call (selector "original")))
                                                (name "error")))
                                            (value (read (slot "last-error"))))
                                          (object-write
                                            (target
                                              (child
                                                (target (call (selector "original")))
                                                (name "error-operation")))
                                            (value (read (slot "last-operation"))))
                                          (object-write
                                            (target
                                              (child
                                                (target (call (selector "original")))
                                                (name "error-receiver")))
                                            (value (read (slot "last-receiver"))))
                                          (object-write
                                            (target
                                              (child
                                                (target (call (selector "original")))
                                                (name "enabled")))
                                            (value false))))
                                      (recover)))))
                              (write
                                (slot "index")
                                (value (add (left (read (slot "index"))) (right 1)))))))))
                    (else))
                  (if
                    (has-child (target (self)) (name "turn"))
                    (then (object-delete (target (child (target (self)) (name "turn")))))
                    (else))
                  (write (slot "running") (value false))
                  (read (slot "work"))))
              (recover
                (do
                  (if
                    (has-child (target (self)) (name "turn"))
                    (then (object-delete (target (child (target (self)) (name "turn")))))
                    (else))
                  (write (slot "running") (value false))
                  (rethrow)))))))))
  (service #service @scope #scope 9
    (heartbeats false)
    (activity 0)
    (probe-sequence 0)
    (awaiting-probe 0)
    (probe-pending false)
    (acknowledgements false)
    (awaiting-revision 0)
    (received-revision 0)
    (accepted-revision 0)
    (rejected-revision 0)
    (origin "local")
    (publication "example")
    (revision 0)
    (enabled true)
    (pending false)
    (complete false)
    (event "snapshot")
    (handlers
      (identity
        (body
          (do
            (if (== (left (read (slot "origin"))) (right "")) (then (fail)) (else))
            (if (== (left (read (slot "publication"))) (right "")) (then (fail)) (else)))))
      (queue
        (body
          (do
            (if
              (read (slot "acknowledgements"))
              (then
                (if (!= (left (read (slot "awaiting-revision"))) (right 0)) (then (fail)) (else)))
              (else (result 0)))
            (do
              (if (read (slot "pending")) (then (fail)) (else))
              (call (selector "identity"))
              (write (slot "revision") (value (add (left (read (slot "revision"))) (right 1))))
              (if
                (has-child (target (self)) (name "draft"))
                (then (object-delete (target (child (target (self)) (name "draft")))))
                (else))
              (object-create (target (self)) (name "draft") (value (unit)))
              (object-create
                (target (child (target (self)) (name "draft")))
                (name "schema")
                (value 1))
              (object-create
                (target (child (target (self)) (name "draft")))
                (name "origin")
                (value (read (slot "origin"))))
              (object-create
                (target (child (target (self)) (name "draft")))
                (name "publication")
                (value (read (slot "publication"))))
              (object-create
                (target (child (target (self)) (name "draft")))
                (name "revision")
                (value (read (slot "revision"))))
              (object-create
                (target (child (target (self)) (name "draft")))
                (name "event")
                (value (read (slot "event"))))
              (if
                (== (left (read (slot "event"))) (right "snapshot"))
                (then
                  (object-copy
                    (target (connection (target (self)) (name "scope")))
                    (destination (child (target (self)) (name "draft")))
                    (name "state")))
                (else))
              (replica-prepare
                (target (connection (target (self)) (name "channel")))
                (value (child (target (self)) (name "draft"))))
              (write (slot "pending") (value true))
              (read (slot "revision")))
            (if
              (read (slot "acknowledgements"))
              (then (write (slot "awaiting-revision") (value (read (slot "revision")))))
              (else (result 0)))
            (read (slot "revision")))))
      (publish
        (body
          (do
            (if (not (value (read (slot "enabled")))) (then (fail)) (else))
            (write (slot "event") (value "snapshot"))
            (call (selector "queue")))))
      (withdraw
        (body
          (do
            (write (slot "event") (value "withdrawal"))
            (call (selector "queue"))
            (write (slot "enabled") (value false))
            (read (slot "revision")))))
      (resume (body (write (slot "enabled") (value true))))
      (send
        (body
          (do
            (if (not (value (read (slot "pending")))) (then (fail)) (else))
            (write
              (slot "complete")
              (value (replica-send (target (connection (target (self)) (name "channel"))))))
            (if (read (slot "complete")) (then (write (slot "pending") (value false))) (else))
            (read (slot "complete")))))
      (validate-reply
        (body
          (do
            (if
              (==
                (left
                  (inspect
                    (target (child (target (child (target (self)) (name "reply"))) (name "event")))))
                (right "alive"))
              (then (call (selector "validate-alive")))
              (else
                (do
                  (if (not (value (read (slot "acknowledgements")))) (then (fail)) (else))
                  (if (read (slot "pending")) (then (fail)) (else))
                  (if (<= (left (read (slot "awaiting-revision"))) (right 0)) (then (fail)) (else))
                  (if
                    (!=
                      (left (child-count (target (child (target (self)) (name "reply")))))
                      (right 5))
                    (then (fail))
                    (else))
                  (if
                    (!=
                      (left
                        (inspect
                          (target
                            (child (target (child (target (self)) (name "reply"))) (name "schema")))))
                      (right 1))
                    (then (fail))
                    (else))
                  (if
                    (!=
                      (left
                        (inspect
                          (target
                            (child (target (child (target (self)) (name "reply"))) (name "origin")))))
                      (right (read (slot "origin"))))
                    (then (fail))
                    (else))
                  (if
                    (!=
                      (left
                        (inspect
                          (target
                            (child
                              (target (child (target (self)) (name "reply")))
                              (name "publication")))))
                      (right (read (slot "publication"))))
                    (then (fail))
                    (else))
                  (if
                    (!=
                      (left
                        (inspect
                          (target
                            (child
                              (target (child (target (self)) (name "reply")))
                              (name "revision")))))
                      (right (read (slot "awaiting-revision"))))
                    (then (fail))
                    (else))
                  (if
                    (==
                      (left
                        (inspect
                          (target
                            (child (target (child (target (self)) (name "reply"))) (name "event")))))
                      (right "received"))
                    (then
                      (write (slot "received-revision") (value (read (slot "awaiting-revision")))))
                    (else
                      (do
                        (if
                          (!=
                            (left (read (slot "received-revision")))
                            (right (read (slot "awaiting-revision"))))
                          (then (fail))
                          (else))
                        (if
                          (==
                            (left
                              (inspect
                                (target
                                  (child
                                    (target (child (target (self)) (name "reply")))
                                    (name "event")))))
                            (right "accepted"))
                          (then
                            (write
                              (slot "accepted-revision")
                              (value (read (slot "awaiting-revision")))))
                          (else
                            (do
                              (if
                                (!=
                                  (left
                                    (inspect
                                      (target
                                        (child
                                          (target (child (target (self)) (name "reply")))
                                          (name "event")))))
                                  (right "rejected"))
                                (then (fail))
                                (else))
                              (write
                                (slot "rejected-revision")
                                (value (read (slot "awaiting-revision")))))))
                        (write (slot "awaiting-revision") (value 0)))))
                  (result true))))
            (write (slot "activity") (value (add (left (read (slot "activity"))) (right 1))))
            (result true))))
      (receive-reply
        (body
          (do
            (if (not (value (read (slot "acknowledgements")))) (then (fail)) (else))
            (if
              (has-child (target (self)) (name "reply"))
              (then (call (selector "validate-reply")))
              (else
                (if
                  (replica-receive (target (connection (target (self)) (name "channel"))))
                  (then
                    (do
                      (replica-import
                        (target (connection (target (self)) (name "channel")))
                        (destination (self))
                        (name "reply"))
                      (call (selector "validate-reply"))))
                  (else (result 0)))))
            (if
              (has-child (target (self)) (name "reply"))
              (then (object-delete (target (child (target (self)) (name "reply")))))
              (else))
            (result 0))))
      (reset-replies
        (body
          (do
            (write (slot "awaiting-revision") (value 0))
            (write (slot "awaiting-probe") (value 0))
            (write (slot "probe-pending") (value false))
            (if
              (has-child (target (self)) (name "probe-draft"))
              (then (object-delete (target (child (target (self)) (name "probe-draft")))))
              (else))
            (if
              (has-child (target (self)) (name "reply"))
              (then (object-delete (target (child (target (self)) (name "reply")))))
              (else))
            (result true))))
      (validate-alive
        (body
          (do
            (do
              (if (not (value (read (slot "heartbeats")))) (then (fail)) (else))
              (if (not (value (read (slot "acknowledgements")))) (then (fail)) (else))
              (if
                (!= (left (child-count (target (child (target (self)) (name "reply"))))) (right 5))
                (then (fail))
                (else))
              (if
                (!=
                  (left
                    (inspect
                      (target
                        (child (target (child (target (self)) (name "reply"))) (name "schema")))))
                  (right 1))
                (then (fail))
                (else))
              (if
                (!=
                  (left
                    (inspect
                      (target
                        (child (target (child (target (self)) (name "reply"))) (name "origin")))))
                  (right (read (slot "origin"))))
                (then (fail))
                (else))
              (if
                (!=
                  (left
                    (inspect
                      (target
                        (child (target (child (target (self)) (name "reply"))) (name "publication")))))
                  (right (read (slot "publication"))))
                (then (fail))
                (else)))
            (if (<= (left (read (slot "awaiting-probe"))) (right 0)) (then (fail)) (else))
            (if
              (!=
                (left
                  (inspect
                    (target
                      (child (target (child (target (self)) (name "reply"))) (name "sequence")))))
                (right (read (slot "awaiting-probe"))))
              (then (fail))
              (else))
            (write (slot "awaiting-probe") (value 0))
            (result true))))
      (probe
        (body
          (do
            (if (not (value (read (slot "heartbeats")))) (then (fail)) (else))
            (if (not (value (read (slot "acknowledgements")))) (then (fail)) (else))
            (if (read (slot "pending")) (then (fail)) (else))
            (if (read (slot "probe-pending")) (then (fail)) (else))
