      (send-probe
        (body
          (do
            (if (not (value (read (slot "probe-pending")))) (then (fail)) (else))
            (if
              (replica-send (target (connection (target (self)) (name "channel"))))
              (then (write (slot "probe-pending") (value false)))
              (else (result 0)))
            (result 0))))))
  (session #session @runtime #session 119 @service #service 127
    (role "publisher")
    (require-authentication false)
    (peer-identity "")
    (heartbeat-interval 32)
    (heartbeat-remaining 0)
    (idle-limit 0)
    (idle-remaining 0)
    (last-activity 0)
    (liveness-expired false)
    (remote-closed false)
    (finish-limit 0)
    (finish-remaining 0)
    (connection-limit 0)
    (connection-remaining 0)
    (phase "stopped")
    (error "")
    (dirty true)
    (retry-delay 2)
    (remaining 0)
    (automatic-retry false)
    (handlers
      (heartbeats-enabled
        (body
          (if
            (has-child (target (connection (target (self)) (name "service"))) (name "heartbeats"))
            (then
              (inspect
                (target
                  (child (target (connection (target (self)) (name "service"))) (name "heartbeats")))))
            (else (result false)))))
      (start-liveness
        (body
          (do
            (write (slot "liveness-expired") (value false))
            (write (slot "idle-remaining") (value (read (slot "idle-limit"))))
            (write (slot "heartbeat-remaining") (value (read (slot "heartbeat-interval"))))
            (if
              (call (selector "heartbeats-enabled"))
              (then
                (write
                  (slot "last-activity")
                  (value
                    (inspect
                      (target
                        (child
                          (target (connection (target (self)) (name "service")))
                          (name "activity")))))))
              (else (result 0)))
            (result true))))
      (idle-step
        (body
          (do
            (if
              (!=
                (left (read (slot "last-activity")))
                (right
                  (inspect
