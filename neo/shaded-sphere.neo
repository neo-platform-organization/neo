                                (right (mul (left (read (slot "m-m12"))) (right 5000)))))
                            (right (mul (left (read (slot "m-m22"))) (right -7700)))))
                        (right 10000)))))))
            (reset-vertices (write (slot "m-i") (value 0)))
            (vertices
              (while
                (condition (< (left (read (slot "m-i"))) (right (read (slot "m-nv")))))
                (body
                  (do
                    (x
                      (write
                        (slot "m-vx")
                        (value (array-get (slot "vertices") (index (mul (left (read (slot "m-i"))) (right 3)))))))
                    (y
                      (write
                        (slot "m-vy")
                        (value
                          (array-get
