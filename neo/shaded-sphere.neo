                                    (right (mul (left (read (slot "m-m21"))) (right (read (slot "m-vy")))))))
                                (right (mul (left (read (slot "m-m22"))) (right (read (slot "m-vz")))))))
                            (right 10000)))))
                    (depth
                      (write
                        (slot "m-depth")
                        (value (add (left (read (slot "m-dist"))) (right (read (slot "m-rz")))))))
                    (sx
                      (array-set
                        (slot "projected")
