                                (right (read (slot "m-depth")))))))))
                    (next (write (slot "m-i") (value (add (left (read (slot "m-i"))) (right 1)))))))))
            (reset-faces (write (slot "m-i") (value 0)))
            (faces
              (while
                (condition (< (left (read (slot "m-i"))) (right (read (slot "m-nf")))))
                (body
                  (do
                    (index (write (slot "m-k") (value (mul (left (read (slot "m-i"))) (right 3)))))
                    (c0
                      (write
                        (slot "s-x0")
                        (value
                          (array-get
